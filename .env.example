# ===== 平台 =====
# console（无需聊天 SDK）或 feishu
PLATFORM=console
CONSOLE_USER_ID=local-user

# ===== 飞书（仅 PLATFORM=feishu 时需要） =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 留空 = 所有人按访客处理（更安全）。
OWNER_OPEN_ID=

# ===== 数据路径 =====
# 记忆、状态、日志、下载文件都放这里。
BOT_HOME=./data

# ===== 本地模型（Ollama） =====
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=your-local-model
LOCAL_TIMEOUT=30
LOCAL_MAX_TOKENS=300
HUMAN_DELAY=1

# ===== 云端兜底 =====
CLOUD_ENABLED=1
CLOUD_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat
OWNER_CLOUD_DAILY=20
GUEST_CLOUD_DAILY=3
CLOUD_TIMEOUT=45

# ===== 记忆 =====
MEM_DAILY_TTL_DAYS=7
MEM_FUZZY_TTL_DAYS=30
MEM_EMOTION_HIGH=0.72

# ===== 行为 =====
ASSISTANT_NAME=YourAI
MAX_UPLOAD_MB=30
MAX_TEXT_READ=204800
PROBE_CONNECT_TIMEOUT=0.2
PROBE_READ_TIMEOUT=0.3
